rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Admin helper
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 2. Global admin override
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Money only moves through the server: the API routes (/api/wallet, /api/trades,
    // /api/game/*, the cron engines) use the Admin SDK, which skips these rules, and
    // check every movement. Players' apps can read their own balances and records
    // but never write them.

    // The two portal accounts get their role from their email (lib/adminAccess);
    // nobody else can give themselves one.
    function isPortalRole(role) {
      return request.auth.token.email_verified == true && (
        (role == 'support' && request.auth.token.email == 'flyovasocials@gmail.com')
        || (role == 'staff' && request.auth.token.email == 'flyovahelpsocials@gmail.com'));
    }

    // Admin, staff and support accounts (the admin panel). A role can only be set by
    // the server or an admin (see users below).
    function isStaff() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'staff', 'support']
        || isPortalRole('support') || isPortalRole('staff'));
    }

    // --- DELETION REQUESTS ---
    match /deletion_requests/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // --- SUPPORT CHAT ---
    match /support_chats/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
    }

    // --- SYSTEM SETTINGS ---
    match /settings/{settingId} {
      allow read: if true; 
    }

    // --- BROADCASTS & JACKPOTS ---
    match /broadcasts/{id} {
      allow read: if request.auth != null;
    }

    // Claimed through /api/wallet.
    match /jackpots/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
 
    // --- USERS COLLECTION ---
    // Account fields a player can never change: only the server or an admin does.
    // So nobody can lift their own ban or restriction, mark their email verified,
    // change who referred them, or touch a balance, bonus or plan (money moves
    // through the server). `role` and `pin` have their own checks below.
    function lockedAccountFields() {
      return ['isban', 'banned', 'verified', 'otp', 'isAgent', 'chatMuted',
        'restrictDeposit', 'restrictWithdrawal', 'restrictTransfer',
        'uid', 'email', 'emailLower', 'createdAt', 'referrerUid', 'referredBy', 'lastAdminLogin',
        'wallet', 'referralBonus', 'agent_balance', 'bonusClaimed', 'bonusDeducted',
        'welcomeBonusClaimed', 'welcomeBonusPaid', 'welcomeBonusAmount', 'welcomeBonusStatus',
        'welcomeBonusPaidAt', 'welcomeBonusRecoveredAt', 'subscription_expires', 'subscription_started_at'];
    }

    function ownAccountChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(lockedAccountFields())
        && (!changed.hasAny(['role']) || isPortalRole(request.resource.data.role))
        // A PIN is given once (sign-up, or the first login without one).
        && (!changed.hasAny(['pin']) || (
          resource.data.get('pin', '') in [null, '']
          && request.resource.data.pin is string
          && request.resource.data.pin.matches('^[0-9]{8}$')));
    }

    // An account (email, phone, date of birth, PIN, balance) is read only by its
    // player and staff. Sign-up checks, the friends lobby, referrals and transfers
    // get what they need from the server.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      // Sign-up: your own account, as a plain player whose only money is the
      // welcome bonus. The email code is made by the server (email_codes).
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('uid', userId) == userId
        && !request.resource.data.keys().hasAny(['isban', 'banned', 'isAgent', 'chatMuted', 'referralBonus', 'otp',
          'agent_balance', 'subscription_expires', 'subscription_started_at',
          'restrictDeposit', 'restrictWithdrawal', 'restrictTransfer'])
        && (!('role' in request.resource.data) || isPortalRole(request.resource.data.role))
        && (request.resource.data.get('verified', false) == false || isPortalRole(request.resource.data.get('role', '')))
        && request.resource.data.get('wallet', 0) in [0, 3];
      allow update: if request.auth != null && request.auth.uid == userId && ownAccountChange();
      allow delete: if false;

      // Balance history: written by the server only.
      match /transactions/{transId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      
      match /support_chats/{userId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- DEPOSITS ---
    // USDT deposits are started and their proof recorded through /api/wallet; admins
    // approve them.
    match /deposits/{id} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isStaff());
    }

    // --- WITHDRAWALS & TESTIMONIALS ---
    // Requested through /api/wallet; admins approve them.
    match /withdrawals/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isStaff());
    }

    match /withdrawal_testimonials/{id} {
      allow create: if request.auth != null;
      allow read: if true;
    }

    // --- AGENTS ---
    // An agent's record (ID photos, contact details, balance) is read only by the
    // agent and staff; players get agent lists and a trade's bank details from
    // /api/trades. An agent edits their rates, bank details and availability; their
    // balance and approval are changed by the server or an admin.
    match /agents/{agentId} {
      allow read: if request.auth != null && (request.auth.uid == agentId || isStaff());
      // Applying (or applying again after a rejection).
      allow create: if request.auth != null && request.auth.uid == agentId
        && request.resource.data.application_status == 'pending'
        && request.resource.data.get('banned', false) == false
        && request.resource.data.get('agent_balance', 0) == 0;
      allow update: if request.auth != null && request.auth.uid == agentId && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deposit_rate', 'withdrawal_rate', 'exchange_rate',
          'ratesUpdatedAt', 'bankName', 'accountName', 'accountNumber', 'phone_number', 'profileUpdatedAt', 'active'])
        || (resource.data.get('application_status', '') != 'approved'
          && resource.data.get('banned', false) == false
          && request.resource.data.application_status == 'pending'
          && request.resource.data.get('banned', false) == false
          && request.resource.data.get('agent_balance', 0) == resource.data.get('agent_balance', 0)));
    }

    // --- TRADES & MESSAGES ---
    // Created and moved along through /api/trades. The two sides (and staff) read a
    // trade and chat in it.
    function isTradeParty(trade) {
      return request.auth.uid == trade.senderId || request.auth.uid == trade.agentId;
    }
    match /trades/{tradeId} {
      allow read: if request.auth != null && (isTradeParty(resource.data) || isStaff());

      match /messages/{msgId} {
        allow read: if request.auth != null
          && (isTradeParty(get(/databases/$(database)/documents/trades/$(tradeId)).data) || isStaff());
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && (isTradeParty(get(/databases/$(database)/documents/trades/$(tradeId)).data) || isStaff());
      }
    }

    // --- CHALLENGES & GAMES ---
    // A challenge names its stake per round (whole dollars); accepting it, which takes
    // both stakes and opens the match, and paying out happen in /api/game/match.
    match /challenges/{challengeId} {
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.stakePerRound is int
        && request.resource.data.stakePerRound >= 1 && request.resource.data.stakePerRound <= 10000;
      allow read, delete: if request.auth != null && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // The players play their moves; what the match is worth stays as the server set it.
    match /games/{gameId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.player1 || request.auth.uid == resource.data.player2);
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.player1 || request.auth.uid == resource.data.player2)
        && resource.data.status == 'active'
        && request.resource.data.status in ['active', 'completed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gameState', 'turn', 'hiddenPick', 'turnStartedAt',
          'picker', 'round', 'scores', 'roundsPlayed', 'numberPool', 'status', 'completedAt', 'wagerPool']);
      match /messages/{messageId} {
        allow read, create: if request.auth != null && request.auth.uid in [
          get(/databases/$(database)/documents/games/$(gameId)).data.player1,
          get(/databases/$(database)/documents/games/$(gameId)).data.player2];
      }
    }

    // --- PREDICT AND FLYOVA ---
    // Predict & Win rounds are made by the server (/api/game/predict), which keeps each
    // outcome on predict_secrets (no rules: server only) until the round ends.
    match /predict_games/{gameId} {
      allow read: if true;
    }
    // Rounds are created and settled only by the server game engine. A round's winning
    // numbers stay on timed_game_secrets until it ends; staff see the live ones on the
    // admin overview.
    match /timed_games/{gameId} { 
      allow read: if true; 
    }
    match /timed_game_secrets/{gameId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'staff'
        || isPortalRole('staff'));
    }

    // --- BLOG ---
    match /blog_posts/{postId} {
      allow read: if resource.data.published == true;
    }

    // ── START: chat rules ──────────────────────────────────────────────────

    function chatSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in account can chat as username `name`: it owns it, or
    // has logged in to it with its password (linkedUids).
    function ownsUsername(name) {
      return chatSignedIn()
        && name is string
        && exists(/databases/$(database)/documents/usernames/$(name))
        && (get(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/usernames/$(name)).data.get('linkedUids', []))
        && get(/databases/$(database)/documents/usernames/$(name)).data.get('deleted', false) == false;
    }

    function chatConvo(convoId) {
      return get(/databases/$(database)/documents/conversations/$(convoId)).data;
    }

    function isChatMember(convoId) {
      return chatSignedIn() && request.auth.uid in chatConvo(convoId).participantUids;
    }

    // A locked group takes messages only from its owner and admins.
    function canPostIn(convoId, sender) {
      let convo = chatConvo(convoId);
      return convo.get('locked', false) != true
        || sender == convo.get('owner', convo.get('createdBy', ''))
        || sender in convo.get('admins', []);
    }

    // Optional reply quote on a message: { id, sender, text } with a short text.
    function validReplyQuote(data) {
      return !('replyTo' in data) || (
        data.replyTo is map
        && data.replyTo.keys().hasOnly(['id', 'sender', 'text'])
        && data.replyTo.id is string
        && data.replyTo.sender is string
        && data.replyTo.text is string
        && data.replyTo.text.size() <= 200
      );
    }

    // A presence change in one of a conversation's per-username maps (readAt or
    // typing) touches only the entry of `actor`, set to now or removed.
    function ownPresenceEntry(before, after, actor) {
      return after.diff(before).affectedKeys().hasOnly([actor])
        && (!after.diff(before).affectedKeys().hasAny([actor]) || !(actor in after) || after[actor] == request.time);
    }

    // Seen / typing: a member changes only their own readAt and typing entries,
    // naming themselves (a username they own) in presenceBy.
    function ownPresenceChange() {
      let actor = request.resource.data.get('presenceBy', '');
      return actor is string && actor.size() > 0
        && ownsUsername(actor)
        && ownPresenceEntry(resource.data.get('typing', {}), request.resource.data.get('typing', {}), actor)
        && ownPresenceEntry(resource.data.get('readAt', {}), request.resource.data.get('readAt', {}), actor);
    }

    match /usernames/{name} {
      allow read, write: if false; // server only (API routes)
    }

    // A profile photo is a small JPEG stored on the profile itself (a data: URL
    // under 100,000 characters), or "" for none — never an outside link.
    function validChatPhoto() {
      return !('photoURL' in request.resource.data)
        || request.resource.data.photoURL == ''
        || (request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() < 100000
          && request.resource.data.photoURL.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }

    match /chat_profiles/{name} {
      allow read: if chatSignedIn();
      allow create, update: if ownsUsername(name)
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && validChatPhoto();
      allow delete: if false;
    }

    match /conversations/{convoId} {
      allow read: if chatSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create, delete: if false; // server only
      allow update: if chatSignedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'blocked', 'typing', 'readAt', 'presenceBy'])
        && request.resource.data.get('blocked', []).hasAll(resource.data.get('blocked', []))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['typing', 'readAt', 'presenceBy']) || ownPresenceChange());

      match /messages/{messageId} {
        allow read: if isChatMember(convoId);
        allow create: if isChatMember(convoId)
          && ownsUsername(request.resource.data.sender)
          && !(request.resource.data.sender in chatConvo(convoId).get('blocked', []))
          && canPostIn(convoId, request.resource.data.sender)
          && chatConvo(convoId).get('closed', false) != true // the other player deleted their username
          && request.resource.data.keys().hasOnly(['sender', 'text', 'createdAt', 'deletedForEveryone', 'replyTo'])
          && validReplyQuote(request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.deletedForEveryone == false
          && request.resource.data.createdAt == request.time;
        // Only the sender may change a message: either "delete for everyone" (placeholder
        // text) or an edit of a live message (new text + editedAt stamp).
        allow update: if ownsUsername(resource.data.sender) && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deletedForEveryone'])
            && request.resource.data.deletedForEveryone == true
            && request.resource.data.text == '— message deleted —'
          ) || (
            resource.data.deletedForEveryone == false
            && resource.data.get('kind', '') != 'coins' // coin cards can't be edited
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text != resource.data.text // unchanged text isn't an edit
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.editedAt == request.time
          )
        );
        allow delete: if false;
      }
    }

    // Document id is "<blocker>_<blocked>" so the server can check blocks by id.
    match /chat_blocks/{blockId} {
      allow read: if ownsUsername(resource.data.blocker);
      allow create, update: if ownsUsername(request.resource.data.blocker)
        && blockId == request.resource.data.blocker + '_' + request.resource.data.blocked;
      allow delete: if ownsUsername(resource.data.blocker);
    }

    // Your private chat state: how far you've read each chat (unread counts) and
    // your read-receipts setting. Only you can see or change it.
    match /chat_state/{uid} {
      allow read, write: if chatSignedIn() && request.auth.uid == uid;
    }

    // Online status per chat username: { lastActive: now, hidden }, written only by its owner.
    match /chat_presence/{name} {
      allow read: if chatSignedIn();
      allow create, update: if ownsUsername(name)
        && request.resource.data.keys().hasOnly(['lastActive', 'hidden'])
        && request.resource.data.lastActive == request.time
        && request.resource.data.hidden is bool;
      allow delete: if false;
    }

    // Chat username passwords: hashes, server only (/api/chat/accounts).
    match /username_auth/{name} {
      allow read, write: if false;
    }

    // Chat coins, one wallet per username: balance and history, changed only by
    // the server (/api/chat/coins). Readable by whoever can chat as the username.
    match /username_wallets/{name} {
      allow read: if ownsUsername(name);
      allow write: if false;

      match /activity/{entryId} {
        allow read: if ownsUsername(name);
        allow write: if false;
      }
    }

    // The old one-per-account coin wallets, moved to each account's main username
    // (lib/coinWallets). Still readable by older apps.
    match /coin_wallets/{uid} {
      allow read: if chatSignedIn() && request.auth.uid == uid;
      allow write: if false;

      match /activity/{entryId} {
        allow read: if chatSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /chat_reports/{reportId} {
      allow create: if ownsUsername(request.resource.data.reporter);
      allow read, update, delete: if false; // review in the console / admin tools
    }

    match /chat_sessions/{sessionId} {
      allow read: if chatSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if chatSignedIn()
        && request.resource.data.uid == request.auth.uid
        && ownsUsername(request.resource.data.usernameLower);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if ownsUsername(request.resource.data.fromUsername);
      allow read, update: if ownsUsername(resource.data.toUsername);
      allow delete: if false;
    }

    // Public chatroom: every signed-in player reads it; posts and deletes go through
    // /api/chat/room so the server can rate-limit and refuse banned/muted players.
    match /chatroom_messages/{messageId} {
      allow read: if chatSignedIn();
      allow write: if false;
    }

    match /chatroom_rate/{uid} {
      allow read, write: if false; // server only (rate limiting)
    }

    // ── END: chat rules ────────────────────────────────────────────────────
  }
}
