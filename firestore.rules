rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Admin helper
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 2. Global admin override
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- DELETION REQUESTS ---
    match /deletion_requests/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // --- SUPPORT CHAT ---
    match /support_chats/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
    }

    // --- SYSTEM SETTINGS ---
    match /settings/{settingId} {
      allow read: if true; 
    }

    // --- BROADCASTS & JACKPOTS ---
    match /broadcasts/{id} {
      allow read: if request.auth != null;
    }

    match /jackpots/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt']);
    }
 
    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read, write: if request.auth != null;
      allow list: if true;

      match /transactions/{transId} {
        allow read, write: if request.auth != null;
      }
      
      match /support_chats/{userId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- DEPOSITS ---
    match /deposits/{id} {
       allow read, list: if request.auth != null;
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
       allow update: if request.auth != null; 
    }

    // --- WITHDRAWALS & TESTIMONIALS ---
    match /withdrawals/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /withdrawal_testimonials/{id} {
      allow create: if request.auth != null;
      allow read: if true;
    }

    // --- AGENTS ---
    match /agents/{agentId} {
      allow read, write: if request.auth != null;
      allow create: if request.auth != null;
    }

    // --- TRADES & MESSAGES ---
    match /trades/{tradeId} {
      allow read, write: if request.auth != null;
      allow list, create: if request.auth != null;
      
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // --- CHALLENGES & GAMES ---
    match /challenges/{challengeId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    match /games/{gameId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.player1 || request.auth.uid == resource.data.player2);
      match /messages/{messageId} { allow read, write: if request.auth != null; }
    }

    // --- PREDICT AND FLYOVA ---
    // CHANGED: players only ever create predict games; nobody edits them from an app.
    // (Was: read, create, update for anyone, even signed out.)
    match /predict_games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
    // CHANGED: rounds are created and settled only by the server game engine, which
    // is not subject to these rules. Was "create, update: if true", which let anyone,
    // even signed out, rewrite a live round's winning numbers before it paid out.
    match /timed_games/{gameId} { 
      allow read: if true; 
      match /bets/{betId} { 
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid; 
        allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid); 
      } 
    }

    // --- BLOG ---
    match /blog_posts/{postId} {
      allow read: if resource.data.published == true;
    }

    // ── START: chat rules ──────────────────────────────────────────────────

    function chatSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in account owns chat username `name`.
    function ownsUsername(name) {
      return chatSignedIn()
        && name is string
        && exists(/databases/$(database)/documents/usernames/$(name))
        && get(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/usernames/$(name)).data.get('deleted', false) == false;
    }

    function chatConvo(convoId) {
      return get(/databases/$(database)/documents/conversations/$(convoId)).data;
    }

    function isChatMember(convoId) {
      return chatSignedIn() && request.auth.uid in chatConvo(convoId).participantUids;
    }

    // Optional reply quote on a message: { id, sender, text } with a short text.
    function validReplyQuote(data) {
      return !('replyTo' in data) || (
        data.replyTo is map
        && data.replyTo.keys().hasOnly(['id', 'sender', 'text'])
        && data.replyTo.id is string
        && data.replyTo.sender is string
        && data.replyTo.text is string
        && data.replyTo.text.size() <= 200
      );
    }

    // A presence change in one of a conversation's per-username maps (readAt or
    // typing) touches only the entry of `actor`, set to now or removed.
    function ownPresenceEntry(before, after, actor) {
      return after.diff(before).affectedKeys().hasOnly([actor])
        && (!after.diff(before).affectedKeys().hasAny([actor]) || !(actor in after) || after[actor] == request.time);
    }

    // Seen / typing: a member changes only their own readAt and typing entries,
    // naming themselves (a username they own) in presenceBy.
    function ownPresenceChange() {
      let actor = request.resource.data.get('presenceBy', '');
      return actor is string && actor.size() > 0
        && ownsUsername(actor)
        && ownPresenceEntry(resource.data.get('typing', {}), request.resource.data.get('typing', {}), actor)
        && ownPresenceEntry(resource.data.get('readAt', {}), request.resource.data.get('readAt', {}), actor);
    }

    match /usernames/{name} {
      allow read, write: if false; // server only (API routes)
    }

    match /chat_profiles/{name} {
      allow read: if chatSignedIn();
      allow create, update: if ownsUsername(name)
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow delete: if false;
    }

    match /conversations/{convoId} {
      allow read: if chatSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create, delete: if false; // server only
      allow update: if chatSignedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'blocked', 'typing', 'readAt', 'presenceBy'])
        && request.resource.data.get('blocked', []).hasAll(resource.data.get('blocked', []))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['typing', 'readAt', 'presenceBy']) || ownPresenceChange());

      match /messages/{messageId} {
        allow read: if isChatMember(convoId);
        allow create: if isChatMember(convoId)
          && ownsUsername(request.resource.data.sender)
          && !(request.resource.data.sender in chatConvo(convoId).get('blocked', []))
          && request.resource.data.keys().hasOnly(['sender', 'text', 'createdAt', 'deletedForEveryone', 'replyTo'])
          && validReplyQuote(request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.deletedForEveryone == false
          && request.resource.data.createdAt == request.time;
        // Only the sender may change a message: either "delete for everyone" (placeholder
        // text) or an edit of a live message (new text + editedAt stamp).
        allow update: if ownsUsername(resource.data.sender) && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deletedForEveryone'])
            && request.resource.data.deletedForEveryone == true
            && request.resource.data.text == '— message deleted —'
          ) || (
            resource.data.deletedForEveryone == false
            && resource.data.get('kind', '') != 'coins' // coin cards can't be edited
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.editedAt == request.time
          )
        );
        allow delete: if false;
      }
    }

    // Document id is "<blocker>_<blocked>" so the server can check blocks by id.
    match /chat_blocks/{blockId} {
      allow read: if ownsUsername(resource.data.blocker);
      allow create, update: if ownsUsername(request.resource.data.blocker)
        && blockId == request.resource.data.blocker + '_' + request.resource.data.blocked;
      allow delete: if ownsUsername(resource.data.blocker);
    }

    // Your private chat state: how far you've read each chat (unread counts) and
    // your read-receipts setting. Only you can see or change it.
    match /chat_state/{uid} {
      allow read, write: if chatSignedIn() && request.auth.uid == uid;
    }

    // Chat coins: balance and history, changed only by the server (/api/chat/coins).
    match /coin_wallets/{uid} {
      allow read: if chatSignedIn() && request.auth.uid == uid;
      allow write: if false;

      match /activity/{entryId} {
        allow read: if chatSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /chat_reports/{reportId} {
      allow create: if ownsUsername(request.resource.data.reporter);
      allow read, update, delete: if false; // review in the console / admin tools
    }

    match /chat_sessions/{sessionId} {
      allow read: if chatSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if chatSignedIn()
        && request.resource.data.uid == request.auth.uid
        && ownsUsername(request.resource.data.usernameLower);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if ownsUsername(request.resource.data.fromUsername);
      allow read, update: if ownsUsername(resource.data.toUsername);
      allow delete: if false;
    }

    // Public chatroom: every signed-in player reads it; posts and deletes go through
    // /api/chat/room so the server can rate-limit and refuse banned/muted players.
    match /chatroom_messages/{messageId} {
      allow read: if chatSignedIn();
      allow write: if false;
    }

    match /chatroom_rate/{uid} {
      allow read, write: if false; // server only (rate limiting)
    }

    // ── END: chat rules ────────────────────────────────────────────────────
  }
}
